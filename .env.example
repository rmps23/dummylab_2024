# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Riot Games API key (server only). Dev keys expire every 24h.
RIOT_API_KEY=

# Demo account (server only)
DEMO_EMAIL=
DEMO_PASSWORD=

# Secret used by the Vercel cron that resets the demo account daily
CRON_SECRET=

# Riot features are off for everyone unless enabled. A development key may not power a public
# product: keep RIOT_ENABLED=false online until a production key is approved.
RIOT_ENABLED=false
# Comma-separated emails that may use Riot features before approval (your own account).
RIOT_ALLOWED_EMAILS=

# Billing (Stripe). Payments stay off until you set BILLING_ENABLED=true. Use test keys (sk_test_...) first.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ACADEMY_MONTHLY=
STRIPE_PRICE_ACADEMY_YEARLY=

# Email (Resend, free plan): weekly report and manual sends. Leave empty to keep email off.
RESEND_API_KEY=
RESEND_FROM=DummyLab <onboarding@resend.dev>

# Anti-spam on the sign-in forms (Cloudflare Turnstile, free). Leave empty to hide the widget.
# See docs/AUTH_AND_EMAIL.md for the Supabase side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics without cookies (Umami: cloud free plan or self-hosted). Leave empty to turn it off.
# Example: https://cloud.umami.is/script.js and the website id from the Umami dashboard.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=
